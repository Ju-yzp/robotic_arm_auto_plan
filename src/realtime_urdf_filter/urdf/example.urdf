<?xml version="1.0" ?>
<robot name="mbot">

<!-- /    COLOR    / -->
	<material name="Black">
		<color rgba="0 0 0 1"/>
	</material>
	<material name="White">
		<color rgba="1 1 1 1"/>
	</material>
	<material name="Blue">
		<color rgba="0 0 1 1"/>
	</material>
	<material name="Red">
		<color rgba="1 0 0 1"/>
	</material>

	<link name="base_link">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0.0"/>
			<geometry>
			<box size="0.4 0.4 0.1"/>
			</geometry>
			<material name="White"/>
		</visual>
	</link>


	<link name="link1">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0.15"/>
			<geometry>
			<box size="0.1 0.2 0.3"/>
			</geometry>
			<material name="Blue"/>
		</visual>
	</link>

	<joint name="joint1" type="revolute">
		<parent link="base_link"/>
		<child link="link1"/>
		<origin rpy="0 0 0" xyz="0 0 0.05"/>
		<axis xyz="0 0 1"/>
		<limit effort="300" lower="-3.14159" upper="3.14159" velocity="1"/>
	</joint>

	<link name="link2">
		<visual>
			<origin rpy="0 0 0" xyz="0 0 0.18"/>
			<geometry>
			<box size="0.2 0.2 0.36"/>
			</geometry>
			<material name="Red"/>
		</visual>
	</link>

	<joint name="joint2" type="revolute">
		<parent link="link1"/>
		<child link="link2"/>
		<origin rpy="0 0 0" xyz="0 0 0.15"/>
		<axis xyz="0 1 0"/>
		<limit effort="300" lower="-3.14159" upper="3.14159" velocity="1"/>
	</joint>

